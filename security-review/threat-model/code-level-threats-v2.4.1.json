                    "score": 5.7,
                    "scored_date": "2026-03-16",
                    "scored_by": "Brian Gray",
                    "safety_related": false
                  }
                },
                {
                  "id": "code-threat-005",
                  "title": "API Key Lifecycle Management Gaps",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "API keys are hashed and stored in database, but no rotation, expiration, or key scoping is visible in code. Compromised keys cannot be revoked without database access. No per-key rate limiting prevents brute-force attacks on the hash. MD5 hashing is weak for key material.",
                  "mitigation": "Implement API key expiration and rotation policies. Add per-key rate limits and request quotas. Use modern key derivation functions (bcrypt, argon2, PBKDF2) instead of MD5. Add key audit logging for all API calls.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": 7.1,
                  "cvss_v4_base": {
                    "AV": "N",
                    "AC": "L",
