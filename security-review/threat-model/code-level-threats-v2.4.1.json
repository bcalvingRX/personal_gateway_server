              "name": "API Application",
              "description": "Express.js API service handling automation endpoints. Validates API keys from authorization header. Processes provisioning and dirty-system queries from external automation clients.",
              "outOfScope": false,
              "hasOpenThreats": true,
              "isWebApplication": true,
              "privilegeLevel": "System",
              "threats": [
                {
                  "id": "code-threat-004",
                  "title": "CORS Misconfiguration in Production",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Information Disclosure",
                  "description": "API app (apps/api-app.js line 15-18) sets CORS origin to '*' in non-development mode. Allows any website to make cross-origin requests to the API. Combined with GET-only design, less severe, but enables information disclosure if attackers trigger GET requests that return sensitive data.",
                  "mitigation": "Restrict CORS origin to known management domains. Whitelist specific origins instead of wildcard. Consider removing CORS entirely if clients are internal.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 4,
                  "score": 5.7,
                  "cvss_v4_base": {
                    "AV": "N",
                    "AC": "L",
                    "AT": "N",
                    "PR": "N",
                    "UI": "N",
                    "VC": "H",
