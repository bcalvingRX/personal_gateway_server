              "isWebApplication": false,
              "privilegeLevel": "System",
              "threats": [
                {
                  "id": "code-threat-007",
                  "title": "Session Cookie Security Properties",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Information Disclosure",
                  "description": "Manager app sets session cookie with secure: true and sameSite: 'strict', but HTTPOnly flag visibility is unclear in code review. If HTTPOnly is not set, JavaScript-based XSS vulnerabilities allow attackers to steal session cookies.",
                  "mitigation": "Explicitly set HTTPOnly: true on session cookies. Verify flag is applied in all environments. Implement CSP headers to prevent XSS. Add SameSite=Strict for CSRF protection.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 7,
                  "score": 5.9,
                  "cvss_v4_base": {
