                {
                  "id": "code-threat-010",
                  "title": "Broad Metrics Schema Flexibility",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Tampering",
                  "description": "Device metrics are accepted with minimal schema validation (mqtt-input.middleware.js validates only that record is a non-null object, not an array). system-metrics-template.js has strict: false. Devices can inject arbitrary fields into metrics. Reporting systems or analytics consuming metrics may process unexpected fields unsafely.",
                  "mitigation": "Define strict metrics schema with whitelisted fields. Validate metrics structure before storage. Sanitize metrics fields when consumed by reporting systems. Add metrics schema versioning.",
