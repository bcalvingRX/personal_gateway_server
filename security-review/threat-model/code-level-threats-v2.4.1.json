                {
                  "id": "code-threat-009",
                  "title": "Flexible MongoDB Schema - Field Injection",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "Multiple schemas use Mongoose strict: false (system-metrics-template.js, device-template.js, state-record-template.js, firmware-template.js). Attackers can inject arbitrary fields into documents. Downstream systems consuming these records may process unexpected fields, enabling injection attacks, privilege escalation via injected permission fields, or data poisoning of metrics.",
                  "mitigation": "Set strict: true on all schemas. Explicitly whitelist allowed fields. Remove minimize: false unless critical for application. Add schema validation at application layer before database writes.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 9,
                  "score": 6.9,
