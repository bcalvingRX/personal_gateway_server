                    "VA": "N",
                    "SC": "N",
                    "SI": "N",
                    "SA": "N",
                    "vector_string": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N",
                    "score": 7.5,
                    "scored_date": "2026-03-16",
                    "scored_by": "Brian Gray",
                    "safety_related": false
                  }
                },
                {
                  "id": "code-threat-003",
                  "title": "Information Disclosure via Error Messages",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Information Disclosure",
                  "description": "Error handler (middleware/error-handler.middleware.js line 7) returns err.message directly to HTTP clients. Internal error details such as database operation failures, missing records, or system state are exposed to unauthenticated users.",
                  "mitigation": "Return generic error messages to clients ('An error occurred'). Log detailed errors server-side only. Implement error classification to avoid leaking system internals.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
