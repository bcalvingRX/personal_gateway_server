                    "score": 7.1,
                    "scored_date": "2026-03-16",
                    "scored_by": "Brian Gray",
                    "safety_related": false
                  }
                },
                {
                  "id": "code-threat-006",
                  "title": "Request Body Logging in API Service",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Information Disclosure",
                  "description": "API service (apps/api-app.js line 32) logs request body globally via middleware. If credentials, API keys, or sensitive automation parameters are sent in request bodies, they are captured in application logs.",
                  "mitigation": "Implement log sanitization for sensitive fields. Use structured logging with field-level filtering. Disable body logging and switch to request ID logging for linking.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 6,
