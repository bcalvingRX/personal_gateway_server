            "id": "manager-app",
            "data": {
              "type": "tm.Process",
              "name": "Manager Application",
              "description": "Express.js web application handling manager portal requests. Processes user authentication via useremail headers, session management, and authorization for administrative functions.",
              "outOfScope": false,
              "hasOpenThreats": true,
              "isWebApplication": true,
              "privilegeLevel": "System",
              "threats": [
                {
                  "id": "code-threat-001",
                  "title": "Development Mode Authentication Bypass",
                  "status": "Open",
                  "severity": "Critical",
                  "type": "Elevation of Privilege",
                  "description": "If application runs in development mode (NODE_ENV !== 'production'), middleware/input.middleware.js:injectMockUser() automatically injects test.admin1@rxfunction.com header, bypassing all authentication. Combined with hardcoded fallback in authtoken.middleware.js:verify(), attackers who can control NODE_ENV gain full admin access.",
                  "mitigation": "Verify NODE_ENV is set to 'production' in deployment. Remove mock user injection entirely from production builds. Use build-time environment variable verification, not runtime checks.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": 9.8,
                  "cvss_v4_base": {
                    "AV": "N",
                    "AC": "L",
                    "AT": "N",
                    "PR": "N",
                    "UI": "N",
                    "VC": "N",
                    "VI": "H",
                    "VA": "N",
                    "SC": "N",
                    "SI": "H",
                    "SA": "H",
                    "vector_string": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:H/VA:N/SC:N/SI:H/SA:H",
                    "score": 9.8,
                    "scored_date": "2026-03-16",
                    "scored_by": "Brian Gray",
                    "safety_related": false
                  }
                },
                {
                  "id": "code-threat-002",
                  "title": "Request Body Logging in Production",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information Disclosure",
                  "description": "Manager app (apps/manager-app.js line 65) logs req.body for debugging. If developers send API keys, authentication tokens, or credentials in request bodies during troubleshooting, they are captured in logs. Logs may be accessible to operators or stored insecurely.",
                  "mitigation": "Remove body logging from production. Implement log sanitization middleware to mask sensitive fields (auth headers, tokens, passwords). Use structured logging with field-level redaction.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": 7.5,
                  "cvss_v4_base": {
                    "AV": "N",
                    "AC": "L",
                    "AT": "N",
                    "PR": "N",
                    "UI": "N",
                    "VC": "H",
